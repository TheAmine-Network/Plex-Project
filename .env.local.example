# ─── Stripe (Test Mode) ─────────────────────────────────────────────
# Utilise les clés test de Stripe (commencent par sk_test_ et pk_test_)
STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_TA_CLE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER_PAR_TA_CLE
