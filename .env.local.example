# ─── Stripe Price IDs (Test Mode) ───────────────────────────────────
STRIPE_PRICE_PRO_MONTHLY=price_REMPLACER
STRIPE_PRICE_PREMIUM_MONTHLY=price_REMPLACER
STRIPE_PRICE_PAY_PER_REPORT=price_REMPLACER

# ─── App ─────────────────────────────────────────────────────────────
